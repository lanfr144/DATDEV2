# =============================================================================
# Book&Ride - Unit 01 - MODEL of .env (dummy values, this file is versioned)
#   cp .env.example .env   then replace every PASSWORD_* value in .env
# .env is ignored by Git (.gitignore). Convention: a dummy password = PASSWORD_<NAME>.
# =============================================================================
COMPOSE_PROJECT_NAME=datdev2-unit01

# ---------- books API (FastAPI) ----------
SERVICE_NAME=books-api
APP_VERSION=0.1.0
# port inside the container / port published on the host
API_PORT=8080
API_HOST_PORT=8101

# ---------- MongoDB (business data + JSON logs) ----------
MONGO_DB=bookandride
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=PASSWORD_MONGO_ROOT_PASSWORD
MONGO_PORT=27017
MONGO_HOST_PORT=27101

# ---------- mongo-express (web UI of MongoDB) ----------
EXPRESS_PORT=8081
EXPRESS_HOST_PORT=8181
EXPRESS_USER=admin
EXPRESS_PASSWORD=PASSWORD_EXPRESS_PASSWORD

# ---------- gRPC (optional profile "grpc", DATOP2 U01) ----------
GRPC_PORT=50051
GRPC_HOST_PORT=50101
