# =============================================================================
# Book&Ride - Unit 03 - COMMON settings of the 3 environments (MODEL, versioned)
#   cp .env.example .env ; cp .env.dev.example .env.dev ; (same for staging, prod)
# The per-environment values and the secrets are in .env.<env> (git-ignored).
# Start one environment:  ./scripts/up.sh dev|staging|prod
# =============================================================================
APP_VERSION=1.0.0
# port inside the containers (identical everywhere)
API_PORT=8080
DB_PORT=5432
MONGO_PORT=27017
MONGO_ROOT_USER=admin
