# =============================================================================
# Book&Ride - Unit 03 - environment "staging" (MODEL: dummy secrets PASSWORD_<NAME>)
#   cp .env.staging.example .env.staging   then put real secrets in .env.staging (git-ignored)
# In real production these secrets come from a vault or the CI, not from a file.
# =============================================================================
APP_ENV=staging
# one Compose project per environment: separate containers, networks, volumes
COMPOSE_PROJECT_NAME=datdev2-unit03-staging
API_HOST_PORT=8302
MONGO_HOST_PORT=27302
# ---------- secrets of THIS environment only ----------
DB_PASSWORD=PASSWORD_DB_PASSWORD
API_KEY=PASSWORD_API_KEY
MONGO_ROOT_PASSWORD=PASSWORD_MONGO_ROOT_PASSWORD
