# =============================================================================
# Book&Ride - Unit 02 - MODEL of .env (dummy values, this file is versioned)
#   cp .env.example .env   then replace every PASSWORD_* value in .env
# Convention: a dummy password = PASSWORD_<NAME>. .env is ignored by Git.
# =============================================================================
COMPOSE_PROJECT_NAME=datdev2-unit02

# ---------- books API (FastAPI) ----------
SERVICE_NAME=books-api
APP_VERSION=0.2.0
API_PORT=8080
API_HOST_PORT=8201

# ---------- books API, Django REST Framework variant ----------
DJANGO_PORT=8000
DJANGO_HOST_PORT=8202
DJANGO_SECRET_KEY=PASSWORD_DJANGO_SECRET_KEY
DJANGO_DEBUG=false

# ---------- MongoDB (business data + JSON logs = system of record) ----------
MONGO_DB=bookandride
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=PASSWORD_MONGO_ROOT_PASSWORD
MONGO_PORT=27017
MONGO_HOST_PORT=27201

# ---------- mongo-express ----------
EXPRESS_PORT=8081
EXPRESS_HOST_PORT=8281
EXPRESS_USER=admin
EXPRESS_PASSWORD=PASSWORD_EXPRESS_PASSWORD

# ---------- Elastic stack (Elasticsearch + Kibana must have the same version) ----------
STACK_VERSION=8.15.3
ES_PORT=9200
ES_HOST_PORT=9221
ES_JAVA_OPTS="-Xms1g -Xmx1g"
# superuser "elastic": administration, curl, login in Kibana
ELASTIC_PASSWORD=PASSWORD_ELASTIC_PASSWORD
# built-in account used by Kibana itself (least privilege, never "elastic")
KIBANA_PASSWORD=PASSWORD_KIBANA_PASSWORD
# account of the API and the shipper: write on books + logs-* only
ES_APP_USER=bookandride_app
ES_APP_PASSWORD=PASSWORD_ES_APP_PASSWORD
KIBANA_PORT=5601
KIBANA_HOST_PORT=5621
# 32+ characters: encrypts the saved objects of Kibana (alerts, reports)
KIBANA_ENCRYPTION_KEY=PASSWORD_KIBANA_ENCRYPTION_KEY

# ---------- shipper MongoDB -> Elasticsearch ----------
LOGS_INDEX=logs-bookandride
SHIP_INTERVAL=5
