# =============================================================================
# Book&Ride - Unit 04 - RELEASE STATE (no secret: this file IS versioned)
# =============================================================================
# What runs in production and how the gateway splits the /rentals traffic.
# Changed ONLY by the scripts (release.sh, canary.sh, rolling.sh, rollback.sh),
# which save the previous state in .release.previous (for rollback.sh).
# GitOps idea: commit this file after each change -> the Git history IS the
# deployment history, and `git revert` of a commit is a rollback (DEVOP2 U04/U05).
# =============================================================================

# version (= image tag) deployed in each slot
BLUE_VERSION=1.0.0
GREEN_VERSION=1.0.0
# simulated defect rate of each slot (0 = healthy release)
BLUE_FAULT_RATE=0
GREEN_FAULT_RATE=0

# bluegreen | canary | rolling
RELEASE_MODE=bluegreen
# slot that receives the traffic in bluegreen mode (and the rest of it in canary mode)
ACTIVE_COLOR=blue
CANARY_COLOR=green
# 1-99 (NGINX refuses 0 %); only used when RELEASE_MODE=canary
CANARY_PERCENT=10
