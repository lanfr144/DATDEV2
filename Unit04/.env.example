# =============================================================================
# Book&Ride - Unit 04 - MODEL of .env (dummy values, this file is versioned)
#   cp .env.example .env   then replace every PASSWORD_* value in .env
# The release state (versions, colors, canary %) is in release.env.
# =============================================================================
COMPOSE_PROJECT_NAME=datdev2-unit04

# ---------- gateway: the ONLY published entry point ----------
GATEWAY_PORT=8401
GATEWAY_LISTEN_PORT=80
RATE_LIMIT=10r/s
RATE_BURST=20

# ---------- HTTPS at the gateway (TLS termination, DATOP2 U04 + DEVOP2 U11) ----------
GATEWAY_TLS_PORT=8443
GATEWAY_TLS_LISTEN_PORT=443
# true = every HTTP request (except /health) is redirected to HTTPS with a 301
GATEWAY_FORCE_HTTPS=false
# API keys -> user ids 1 and 2 (checked by the gateway)
API_KEY_USER1=PASSWORD_API_KEY_USER1
API_KEY_USER2=PASSWORD_API_KEY_USER2

# ---------- books service (former monolith, config.yaml block "prod") ----------
APP_ENV=prod
BOOKS_VERSION=1.0.0
BOOKS_PORT=8080
DB_PASSWORD=PASSWORD_DB_PASSWORD

# ---------- rentals service (blue + green) + its OWN database ----------
RENTALS_PORT=8080
RENTALS_DB_USER=rentals
RENTALS_DB_PASSWORD=PASSWORD_RENTALS_DB_PASSWORD
RENTALS_DB_NAME=rentals
RENTALS_DB_PORT=5432
# rentals -> books call: seconds before "books unavailable" (503)
BOOKS_TIMEOUT=2.0

# ---------- logs (MongoDB, shared by all services) ----------
MONGO_PORT=27017
MONGO_HOST_PORT=27401
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=PASSWORD_MONGO_ROOT_PASSWORD

# ---------- monitoring ----------
PROMETHEUS_PORT=9090
PROMETHEUS_HOST_PORT=9491
